{
  "name": "dsh-model-sync",
  "version": "3.1.3",
  "private": true,
  "description": "同步已配置供应商的模型清单：定期问上游要目录，由你在设置面板里逐项确认后再写回 providers.<route>.models —— 永不新增 provider 键。Keep the models a configured provider serves in step with what it advertises upstream, without ever adding a provider.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts"
  ],
  "scripts": {
    "test": "node --test",
    "live": "node scripts/live-discovery.mjs",
    "boot-graph": "node scripts/boot-graph.mjs",
    "verify": "node scripts/verify.mjs",
    "rehearse": "node scripts/rehearse.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen1pengvincent/dsh-model-sync-plugin.git"
  },
  "homepage": "https://github.com/chen1pengvincent/dsh-model-sync-plugin#readme",
  "bugs": {
    "url": "https://github.com/chen1pengvincent/dsh-model-sync-plugin/issues"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "model-sync",
    "model-catalog",
    "openai",
    "anthropic",
    "gemini",
    "deepseek",
    "opencode",
    "ollama"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
