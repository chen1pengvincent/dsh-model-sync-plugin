{
  "name": "dsh-model-sync",
  "version": "3.1.4",
  "private": true,
  "description": "DSH (DeepSeek Harness) 模型目录自动同步与管理插件：自动发现已配置厂商的新模型、核对上下文窗口/最大输出/多模态/推理档位参数、勾选对话下拉框可见模型，并提供本地协议转换网关与系统代理路由。Auto-discover upstream LLM catalogs, verify model metadata (contextWindow, maxTokens, modalities, reasoning efforts), and manage model selector visibility without adding extra provider keys.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "scripts"
  ],
  "scripts": {
    "test": "node --test",
    "live": "node scripts/live-discovery.mjs",
    "boot-graph": "node scripts/boot-graph.mjs",
    "verify": "node scripts/verify.mjs",
    "rehearse": "node scripts/rehearse.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chen1pengvincent/dsh-model-sync-plugin.git"
  },
  "homepage": "https://github.com/chen1pengvincent/dsh-model-sync-plugin#readme",
  "bugs": {
    "url": "https://github.com/chen1pengvincent/dsh-model-sync-plugin/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "model-sync",
    "model-catalog",
    "model-manager",
    "model-selector",
    "models-dev",
    "llm-gateway",
    "protocol-adapter",
    "system-proxy",
    "context-window",
    "max-tokens",
    "reasoning-effort",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "google",
    "deepseek",
    "kimi",
    "moonshot",
    "grok",
    "xai",
    "qwen",
    "dashscope",
    "minimax",
    "zhipu",
    "glm",
    "opencode",
    "ollama",
    "模型同步",
    "模型管理",
    "模型列表",
    "下拉框过滤",
    "系统代理",
    "协议转换"
  ],
  "license": "MIT",
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "dsh": {
    "client": {
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
